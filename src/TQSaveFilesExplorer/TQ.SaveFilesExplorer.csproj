<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RootNamespace>TQ.SaveFilesExplorer</RootNamespace>
		<AssemblyName>TQ.SaveFilesExplorer</AssemblyName>
		<!-- Legacy code, not annotated for nullable reference types. -->
		<Nullable>enable</Nullable>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
		<Platforms>AnyCPU;x64;x86</Platforms>
		<UseWindowsForms>true</UseWindowsForms>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<NoWarn>$(NoWarn);WFO1000</NoWarn>
		<AssemblyTitle>Titan Quest Save Files Explorer</AssemblyTitle>
		<Description>Tool for exploring Titan Quest's save files.</Description>
		<Company>titanquest.net community</Company>
		<Product>Titan Quest Save Files Explorer</Product>
		<Copyright>Copyright © 2019 by hguy</Copyright>
		<ComVisible>false</ComVisible>
		<ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="TQVaultAE.Tests.Win32" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Enums.NET" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
	</ItemGroup>

	<ItemGroup>
		<!-- The save folders (IGamePathService) and the game's text encoding come from TQVault's shared layers. -->
		<ProjectReference Include="..\TQVaultAE.Config\TQVaultAE.Config.csproj" />
		<ProjectReference Include="..\TQVaultAE.Data\TQVaultAE.Data.csproj" />
		<ProjectReference Include="..\TQVaultAE.Services\TQVaultAE.Services.csproj" />
		<ProjectReference Include="..\TQVaultAE.Services.Win32\TQVaultAE.Services.Win32.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Documents\HowTo.pdf" />
	</ItemGroup>

</Project>
