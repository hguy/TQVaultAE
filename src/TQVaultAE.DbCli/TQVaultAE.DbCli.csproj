<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>tqdb</AssemblyName>
		<RootNamespace>TQVaultAE.DbCli</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<InvariantGlobalization>true</InvariantGlobalization>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<TieredPGO>true</TieredPGO>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\TQVaultAE.GameFiles\TQVaultAE.GameFiles.csproj" />
		<Using Include="TQVaultAE.GameFiles" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Magick.NET-Q8-AnyCPU" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="TQVaultAE.DbCli.Tests" />
		<InternalsVisibleTo Include="TQVaultAE.Data.Tests" />
		<InternalsVisibleTo Include="TQVaultAE.Services.Tests" />
	</ItemGroup>

</Project>
