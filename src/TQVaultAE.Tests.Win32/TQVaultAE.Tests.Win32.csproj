<Project Sdk="Microsoft.NET.Sdk">

	<!-- Tests of the Windows-only projects. Platform-agnostic tests go in the TQVaultAE.<Layer>.Tests project of their layer. -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<!-- xunit v3 test projects are executables run by Microsoft.Testing.Platform. -->
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AwesomeAssertions" />
		<PackageReference Include="coverlet.MTP" />
		<PackageReference Include="Moq" />
		<PackageReference Include="xunit.v3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TQVaultAE.Presentation.Win32\TQVaultAE.Presentation.Win32.csproj" />
		<ProjectReference Include="..\TQVaultAE.Services.Win32\TQVaultAE.Services.Win32.csproj" />
		<ProjectReference Include="..\ARZExplorer\ArzExplorer.csproj" />
		<ProjectReference Include="..\TQSaveFilesExplorer\TQ.SaveFilesExplorer.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Synthetic .arz/.arc builders shared with TQVaultAE.DbCli.Tests. -->
		<Compile Include="..\TQVaultAE.DbCli.Tests\DbCliFixtures.cs" Link="Fixtures\DbCliFixtures.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- Coverage settings shared by the test projects: only our own assemblies are measured. -->
		<None Include="..\testconfig.json" Link="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
