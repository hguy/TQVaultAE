<Project Sdk="Microsoft.NET.Sdk">

	<!-- Tests of the Windows-only projects. Platform-agnostic tests go in TQVaultAE.Tests. -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<!-- xunit v3 test projects are executables run by Microsoft.Testing.Platform. -->
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AwesomeAssertions" />
		<PackageReference Include="coverlet.MTP" />
		<PackageReference Include="Moq" />
		<PackageReference Include="xunit.v3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TQVaultAE.Presentation.Win32\TQVaultAE.Presentation.Win32.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
