<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit v3 test projects are executables run by Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Enums.NET" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TQVaultAE.Data\TQVaultAE.Data.csproj" />
    <ProjectReference Include="..\TQVaultAE.Domain\TQVaultAE.Domain.csproj" />
    <ProjectReference Include="..\TQVaultAE.Services\TQVaultAE.Services.csproj" />
    <ProjectReference Include="..\TQVaultAE.Presentation\TQVaultAE.Presentation.csproj" />
    <ProjectReference Include="..\TQVaultAE.DbCli\TQVaultAE.DbCli.csproj" />
    <ProjectReference Include="..\TQVaultAE.Logs\TQVaultAE.Logs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data\SaveFiles\*.chr;Data\SaveFiles\*.dxb;Data\SaveFiles\*.dxg;Data\SaveFiles\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Data\Particles.arc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The UserConfig.xml template shipped with the app, under another name so that UserSettings.Read() does not find it. -->
    <None Include="..\TQVaultAE.Config\UserConfig.xml" Link="Config\UserConfig.template.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Coverage settings shared by the test projects: only our own assemblies are measured. -->
    <None Include="..\testconfig.json" Link="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="TQVaultAE.GameFiles" />
  </ItemGroup>

</Project>